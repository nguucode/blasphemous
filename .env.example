# Copy to .env.local and fill in. Never commit real values.

# Supabase (public by design): Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Postgres, secret: Supabase → Connect → Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Production only. One domain for the app and Demo Links; leave unset locally so links point at localhost.
# DEMO_HOST=blasphemous.ontheshore.biz

